# Pflicht ab Phase 0 — SEC Fair Access Policy verlangt eine echte Kontakt-Email im User-Agent
EDGAR_CONTACT_EMAIL=you@example.com
EDGAR_APP_NAME=Scout Research

# Ab Phase 1 (Marktdaten)
FINNHUB_API_KEY=

# Ab Phase 3 (Agent-Schicht)
ANTHROPIC_API_KEY=
# Modell-ID (feste Snapshots, siehe docs/decisions/phase-3-plan.md); leer = Default claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Effort-Stufe: low | medium | high | xhigh | max (Default medium)
# ANTHROPIC_EFFORT=medium
# max_tokens je Modellaufruf (inkl. Thinking); Default 8000
# ANTHROPIC_MAX_TOKENS=8000
# Ausgabesprache des Agenten: de | en (Default de)
# OUTPUT_LANGUAGE=de
# Ordner der Trace-Dateien (JSONL je Lauf); Default runs/. Liegt das Projekt in iCloud (Desktop), für Live-Läufe einen
# lokalen Pfad außerhalb wählen.
# RUNS_DIR=runs
# Budgetdeckel in US-Dollar, zusätzlich zur Sitzungsgrenze (es gilt die strengste): je Lauf (Default 1.0) und je UTC-Tag
# über alle Läufe (Default 3.0); das Kostenbuch liegt unter RUNS_DIR/spend_ledger.json
# BUDGET_RUN_USD=1.0
# BUDGET_DAY_USD=3.0

# Finnhub-Throttle (Free-Tier ~60/min; 55 lässt Spielraum)
# FINNHUB_REQUESTS_PER_MINUTE=55
