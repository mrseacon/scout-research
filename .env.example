# Pflicht ab Phase 0 — SEC Fair Access Policy verlangt eine echte Kontakt-Email im User-Agent
EDGAR_CONTACT_EMAIL=you@example.com
EDGAR_APP_NAME=Scout Research

# Ab Phase 1 (Marktdaten)
FINNHUB_API_KEY=

# Ab Phase 3 (Agent-Schicht)
ANTHROPIC_API_KEY=
# Modell-ID (feste Snapshots, siehe docs/decisions/phase-3-plan.md); leer = Default claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optionales Vergleichsmodell für Evaluationsläufe (Phase 5)
# ANTHROPIC_COMPARE_MODEL=claude-haiku-4-5-20251001
# Effort-Stufe: low | medium | high | xhigh | max (Default medium)
# ANTHROPIC_EFFORT=medium
# Ausgabesprache des Agenten: de | en (Default de)
# OUTPUT_LANGUAGE=de

# Finnhub-Throttle (Free-Tier ~60/min; 55 lässt Spielraum)
# FINNHUB_REQUESTS_PER_MINUTE=55
